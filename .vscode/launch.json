{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debugger",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: g++ build active file",
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
                "MIMode": "gdb",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
            }
        },
        {
            "name": "Run project7",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/CS1410/wk11/project7/Main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/CS1410/wk11/project7",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: g++ build project7",
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "program": "${workspaceFolder}/CS1410/wk11/project7/Main.exe",
                "MIMode": "gdb",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
            }
        }
    ]
}