{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "args": [
                    "-fdiagnostics-color=always",
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}.exe"
                ]
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build project7",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/CS1410/wk11/project7/Main.cpp",
                "${workspaceFolder}/CS1410/wk11/project7/Student.cpp",
                "-o",
                "${workspaceFolder}/CS1410/wk11/project7/Main"
            ],
            "options": {
                "cwd": "${workspaceFolder}/CS1410/wk11/project7"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "args": [
                    "-fdiagnostics-color=always",
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "-g",
                    "${workspaceFolder}/CS1410/wk11/project7/Main.cpp",
                    "${workspaceFolder}/CS1410/wk11/project7/Student.cpp",
                    "-o",
                    "${workspaceFolder}/CS1410/wk11/project7/Main.exe"
                ]
            }
        }
    ]
}