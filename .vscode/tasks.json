{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/*.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build project7",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/CS1410/wk11/project7/Main.cpp",
                "${workspaceFolder}/CS1410/wk11/project7/Student.cpp",
                "-o",
                "${workspaceFolder}/CS1410/wk11/project7/Main"
            ],
            "options": {
                "cwd": "${workspaceFolder}/CS1410/wk11/project7"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
